{
    "name": "pericles-initiative",
    "type": "module",
    "author": "Florian Trayon (https://github.com/FlorianLeChat)",
    "license": "MIT",
    "private": true,
    "version": "1.0.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/FlorianLeChat/Pericles-Initiative.git"
    },
    "bugs": {
        "url": "https://github.com/FlorianLeChat/Pericles-Initiative/issues"
    },
    "imports": {
        "#lib/*": "./src/lib/*"
    },
    "devDependencies": {
        "vite": "~8.3.0",
        "husky": "~9.1",
        "eslint": "~10.13.0",
        "svelte": "~5.57.0",
        "marked": "~18.1.0",
        "globals": "~17.13.0",
        "prettier": "~3.9",
        "typescript": "~6.0",
        "@eslint/js": "~10.0",
        "tailwindcss": "~4.3",
        "lint-staged": "~17.6.0",
        "svelte-check": "~4.7",
        "@sveltejs/kit": "~3.1.0",
        "@milkdown/kit": "~7.22",
        "@lucide/svelte": "~1.61.0",
        "@faker-js/faker": "~10.6",
        "@milkdown/crepe": "~7.22",
        "@commitlint/cli": "~21.2.0",
        "flowbite-svelte": "~1.33",
        "@tsconfig/svelte": "~5.0",
        "@types/node": "~22.20",
        "@playwright/test": "~1.64.0",
        "@tailwindcss/vite": "~4.3",
        "typescript-eslint": "~8.72.0",
        "@inlang/paraglide-js": "~2.29.0",
        "eslint-plugin-svelte": "~3.23.0",
        "@axe-core/playwright": "~4.14.0",
        "prettier-plugin-svelte": "~4.1.0",
        "eslint-formatter-gitlab": "~7.2",
        "@tailwindcss/typography": "~0.5",
        "@stylistic/eslint-plugin": "~5.10",
        "@sveltejs/adapter-static": "~4.0.0",
        "@commitlint/config-conventional": "~21.2.0"
    },
    "engines": {
        "node": ">=22.17",
        "npm": ">=10.5"
    },
    "scripts": {
        "dev": "vite",
        "test": "playwright test",
        "lint": "eslint . --format gitlab --ext .js,.ts,.svelte",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "build": "vite build",
        "format": "prettier --write \"**/*.{js,ts,svelte}\"",
        "preview": "vite preview",
        "prepare": "husky && svelte-kit sync || echo ''",
        "commitlint": "commitlint --edit",
        "lint-staged": "lint-staged"
    },
    "browserslist": [
        "defaults"
    ]
}
